# ============================================================
# 第一阶段：构建
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app

# 先复制 package.json，利用 npm 缓存
COPY finance-ui/package.json finance-ui/package-lock.json ./
RUN npm ci

# 复制源码并构建
COPY finance-ui/ ./
RUN npm run build

# ============================================================
# 第二阶段：运行（使用 Nginx 提供静态文件）
# ============================================================
FROM nginx:alpine

# 删除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 复制构建产物到 Nginx 目录
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制自定义 Nginx 配置（支持 SPA 路由）
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
